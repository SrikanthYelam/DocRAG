{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenAI": {
    "ApiKey": "",
    "EmbeddingModel": "text-embedding-3-small",
    "ChatModel": "gpt-4o-mini",
    "EmbeddingDimensions": 1536,
    "EmbeddingBatchSize": 96
  },
  "VectorStore": {
    "DatabasePath": "data/docrag.db",
    "Dimensions": 1536
  },
  "Chunking": {
    "TargetTokens": 400,
    "MaxTokens": 500,
    "OverlapFraction": 0.12
  },
  "Retrieval": {
    "Mode": "Hybrid",
    "CandidatePoolSize": 20,
    "RrfK": 60
  },
  "Answer": {
    "MinSimilarity": 0.30
  }
}
